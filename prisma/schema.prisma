// ThreadLine — shared schema. See prompts/01_chezhil_claude.md for the ownership contract.
// Never edit an existing model's fields without flagging it in AI_NOTES.md — only add additively.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(uuid())
  name              String
  role              String // owner | storekeeper | floor_supervisor | qc_inspector
  passwordHash      String
  createdAt         DateTime           @default(now())
  sessions          Session[]
  notificationReads NotificationRead[]
}

model Session {
  tokenHash String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// archivedAt (Supplier, Buyer, YarnType, Worker): a record other rows still
// point at can't be deleted, so it is archived instead — hidden from the
// pickers that start new work, kept for history and restorable.
model Supplier {
  id         String    @id @default(uuid())
  name       String
  contact    String
  gstin      String?
  archivedAt DateTime?
  yarnLots   YarnLot[]
}

model Buyer {
  id         String     @id @default(uuid())
  name       String
  contact    String
  gstin      String?
  address    String?
  archivedAt DateTime?
  orders     Order[]
  dispatches Dispatch[]
}

model YarnType {
  id                  String            @id @default(uuid())
  name                String
  count               String
  material            String
  colour              String
  lowStockThresholdKg Float
  costPerKg           Float
  archivedAt          DateTime?
  lots                YarnLot[]
  purchaseRequests    PurchaseRequest[]
}

model YarnLot {
  id             String                 @id @default(uuid())
  yarnTypeId     String
  yarnType       YarnType               @relation(fields: [yarnTypeId], references: [id])
  supplierId     String
  supplier       Supplier               @relation(fields: [supplierId], references: [id])
  lotNo          String
  qtyReceivedKg  Float
  qtyRemainingKg Float
  receivedAt     DateTime
  linkedOrderId  String?
  reservations   OrderYarnReservation[]
  rolls          Roll[]
}

model Order {
  id                String                 @id @default(uuid())
  orderNo           String                 @unique // e.g. EVR-2610-014
  buyerId           String
  buyer             Buyer                  @relation(fields: [buyerId], references: [id])
  fabricType        String
  colour            String
  gsm               Int
  qtyMetres         Float
  pricePerMetre     Float
  deadline          DateTime
  status            String // NEW|CONFIRMED|IN_PRODUCTION|QC|READY|DISPATCHED|CLOSED — derived display value, see src/lib/order-status.ts. Only NEW->CONFIRMED and DISPATCHED->CLOSED are set directly; everything in between is computed from the four fields below.
  productionStatus  String                 @default("NOT_STARTED") // NOT_STARTED|IN_PRODUCTION|DONE
  qcStatus          String                 @default("PENDING") // PENDING|PASS|NEEDS_REWORK — aggregated from this order's Roll.qcStatus, not set directly
  dispatchStatus    String                 @default("NOT_DISPATCHED") // NOT_DISPATCHED|PARTIALLY_DISPATCHED|FULLY_DISPATCHED
  paymentStatus     String                 @default("UNPAID") // UNPAID|PARTIAL|PAID — derived from this order's Invoice/Payment rows
  trackingToken     String                 @unique
  feasibilityResult String?
  createdAt         DateTime               @default(now())
  reservations      OrderYarnReservation[]
  workOrders        WorkOrder[]
  rolls             Roll[]
  invoices          Invoice[]
}

model OrderYarnReservation {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  yarnLotId String
  yarnLot   YarnLot @relation(fields: [yarnLotId], references: [id])
  qtyKg     Float
}

model Machine {
  id                     String               @id @default(uuid())
  name                   String
  type                   String // spinning|loom|dyeing
  status                 String // RUNNING|IDLE|BREAKDOWN|MAINTENANCE
  capacityMetresPerShift Float
  workOrders             WorkOrder[]
  productionLogs         ProductionLog[]
  rolls                  Roll[]
  maintenanceRequests    MaintenanceRequest[]
}

model WorkOrder {
  id             String          @id @default(uuid())
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id])
  stage          String // spinning|weaving|dyeing
  machineId      String
  machine        Machine         @relation(fields: [machineId], references: [id])
  plannedQty     Float
  producedQty    Float           @default(0)
  status         String
  startedAt      DateTime?
  finishedAt     DateTime?
  productionLogs ProductionLog[]
  rolls          Roll[]
}

model ProductionLog {
  id          String    @id @default(uuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])
  machineId   String
  machine     Machine   @relation(fields: [machineId], references: [id])
  shift       String
  qtyProduced Float
  loggedAt    DateTime  @default(now())
  loggedBy    String
}

model Roll {
  id           String     @id @default(uuid())
  rollNo       String     @unique
  orderId      String
  order        Order      @relation(fields: [orderId], references: [id])
  workOrderId  String
  workOrder    WorkOrder  @relation(fields: [workOrderId], references: [id])
  machineId    String
  machine      Machine    @relation(fields: [machineId], references: [id])
  shift        String
  yarnLotId    String
  yarnLot      YarnLot    @relation(fields: [yarnLotId], references: [id])
  lengthMetres Float
  weightKg     Float
  qcStatus     String // PENDING|PASS|REWORK|REJECT
  dispatchId   String?
  dispatch     Dispatch?  @relation(fields: [dispatchId], references: [id])
  qrToken      String     @unique
  qcRecords    QCRecord[]
}

model QCRecord {
  id          String    @id @default(uuid())
  rollId      String
  roll        Roll      @relation(fields: [rollId], references: [id])
  inspectorId String
  result      String // PASS|REWORK|REJECT
  defects     String // JSON-encoded string array: hole|colour_mismatch|uneven_weave
  notes       String?
  inspectedAt DateTime  @default(now())
  reversal    Reversal?
}

model Dispatch {
  id           String   @id @default(uuid())
  buyerId      String
  buyer        Buyer    @relation(fields: [buyerId], references: [id])
  truckNo      String
  dispatchedAt DateTime @default(now())
  invoiceId    String?
  rolls        Roll[]
}

model Invoice {
  id        String    @id @default(uuid())
  invoiceNo String    @unique
  orderId   String
  order     Order     @relation(fields: [orderId], references: [id])
  buyerId   String
  subtotal  Float
  gst       Float
  total     Float
  status    String
  // Additive (Module 4): invoice date, needed to put revenue in the right month.
  // Defaulted so Module 1's invoice creation code needs no change.
  createdAt DateTime  @default(now())
  payments  Payment[]
  reversal  Reversal?
}

model Payment {
  id         String    @id @default(uuid())
  invoiceId  String
  invoice    Invoice   @relation(fields: [invoiceId], references: [id])
  amount     Float
  receivedAt DateTime  @default(now())
  mode       String
  reversal   Reversal?
}

model Worker {
  id         String       @id @default(uuid())
  name       String
  dailyWage  Float
  role       String
  archivedAt DateTime?
  attendance Attendance[]
}

model Attendance {
  id        String   @id @default(uuid())
  workerId  String
  worker    Worker   @relation(fields: [workerId], references: [id])
  date      DateTime
  shift     String
  status    String // present|absent|half_day
  machineId String?
  // The worker's daily wage when this mark was made, so a later raise doesn't
  // rewrite past months' wages and costing. Null only on rows written before
  // the column existed (backfilled by the migration).
  dailyWage Float?

  @@unique([workerId, date, shift])
}

model Expense {
  id       String    @id @default(uuid())
  category String // yarn|wages|power|overhead|other
  amount   Float
  date     DateTime
  orderId  String?
  // Additive (Module 4): bill no. / vendor / description for the expense.
  note     String?
  reversal Reversal?
}

// Reverse-and-correct for the append-only records: a Payment, Expense,
// Invoice or QC inspection is never edited or deleted. Reversing one inserts
// this row (exactly one of the four ids is set; each is unique, so a record
// is reversed at most once) and, for money, a reversing LedgerEntry in the
// same transaction. Every reader skips reversed rows. A correction is a new
// row of the same kind, linked here by replacementId.
model Reversal {
  id            String    @id @default(uuid())
  paymentId     String?   @unique
  payment       Payment?  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  expenseId     String?   @unique
  expense       Expense?  @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  invoiceId     String?   @unique
  invoice       Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  qcRecordId    String?   @unique
  qcRecord      QCRecord? @relation(fields: [qcRecordId], references: [id], onDelete: Restrict)
  reason        String
  replacementId String?
  reversedBy    String
  createdAt     DateTime  @default(now())
}

model Notification {
  id        String             @id @default(uuid())
  type      String
  message   String
  severity  String // info|warning|critical
  read      Boolean            @default(false)
  createdAt DateTime           @default(now())
  reads     NotificationRead[]
}

// Per-user "I've seen this" marks. Notification.read stays the mill-wide
// "resolved" flag (derived alerts set it when their condition clears); one
// user marking alerts read no longer hides them from everyone else.
model NotificationRead {
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@id([notificationId, userId])
  @@index([userId])
}

model AuditLog {
  id       String   @id @default(uuid())
  entity   String
  entityId String
  action   String
  oldValue String?
  newValue String?
  userId   String
  at       DateTime @default(now())
}

model AlertDelivery {
  id             String    @id @default(uuid())
  notificationId String?
  channel        String // WHATSAPP | EMAIL | SMS | IN_APP
  recipient      String // phone number or email
  templateName   String?
  payload        String // JSON stringified payload
  status         String    @default("PENDING") // PENDING | SENDING | SENT | FAILED | RETRYING
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  lastError      String?
  scheduledFor   DateTime  @default(now())
  sentAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([status, scheduledFor])
}

// HARDENING_ADDENDUM.md item 3: additive audit trail sitting alongside
// Payment/Expense/Invoice, not a replacement for them — those stay the
// source costing.ts/summary.ts compute from. Every Payment, Expense and
// Invoice write also writes one of these in the same transaction, so "where
// did this number come from" is "list the ledger rows for this source,"
// without touching the (already heavily-tested) cost-allocation engine.
model LedgerEntry {
  id         String   @id @default(uuid())
  date       DateTime
  type       String // revenue | yarn_cost | wage_cost | power_cost | overhead | payment_received | reversal
  // Positive for an original entry, negative for a row that reverses one —
  // so SUM(amount) nets out correctly without the reader needing to special-
  // case reversesId. (The addendum's own sketch said "always positive"; this
  // is the one deliberate deviation — noted in AI_NOTES.md.)
  amount     Float
  sourceType String // "Invoice" | "Payment" | "Expense"
  sourceId   String
  orderId    String? // denormalized for a fast per-order ledger query
  reversesId String? // set only on a reversing entry; original rows are never edited or deleted
  note       String?
  createdAt  DateTime @default(now())

  @@index([sourceType, sourceId])
  @@index([type, date])
  @@index([orderId])
}

// HARDENING_ADDENDUM.md item 4: each a small PENDING -> APPROVED/REJECTED
// state machine, raised by the role that hits the real-world trigger
// (low stock, a machine BREAKDOWN, month-end), approved only by the owner.
// Approving never auto-creates the downstream real-world row (a YarnLot, a
// fixed machine) — that still happens through its own existing write path
// when the real event (delivery, repair) actually occurs; approval here is
// the green light, not the event itself. Approving a payout is the one
// exception: it does create an Expense + ledger entry, because "approved"
// *is* the real-world event for a payout (the owner releasing the money).
model PurchaseRequest {
  id          String    @id @default(uuid())
  yarnTypeId  String
  yarnType    YarnType  @relation(fields: [yarnTypeId], references: [id])
  qtyKg       Float
  requestedBy String
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED
  approvedBy  String?
  approvedAt  DateTime?
  note        String?
  createdAt   DateTime  @default(now())
}

model MaintenanceRequest {
  id          String    @id @default(uuid())
  machineId   String
  machine     Machine   @relation(fields: [machineId], references: [id])
  description String
  requestedBy String
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED
  approvedBy  String?
  approvedAt  DateTime?
  cost        Float?
  createdAt   DateTime  @default(now())
}

model PayoutApproval {
  id          String    @id @default(uuid())
  month       String // YYYY-MM
  totalWages  Float
  requestedBy String
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED
  approvedBy  String?
  approvedAt  DateTime?
  expenseId   String? // set once approval creates the payout Expense
  createdAt   DateTime  @default(now())

  @@unique([month])
}
