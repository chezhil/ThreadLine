# Runtime: Supabase transaction pooler (port 6543) with pgbouncer=true
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
# Migrations (prisma migrate): session pooler / direct connection (port 5432)
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# AI assistant (optional). Without a key the assistant falls back to keyword
# routing — get a key at https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_TIMEOUT_MS=20000

# WhatsApp Cloud API (optional). Without these, buyer alerts in the outbox are
# simulated; the "Open in WhatsApp" preview works regardless. Meta only allows
# business-initiated free text inside the 24h customer window - see
# src/lib/alerts/whatsapp-cloud.ts.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Approved Meta message templates (needed to message buyers outside the 24h
# window); parameter order is documented in the README. Leave empty to send text.
WHATSAPP_TEMPLATE_ORDER_READY=""
WHATSAPP_TEMPLATE_ORDER_DISPATCHED=""
WHATSAPP_TEMPLATE_LANG="en"
# Webhook: set the callback URL in the Meta app to https://<host>/api/webhooks/whatsapp
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
# Used to build tracking links in outbox messages:
NEXT_PUBLIC_APP_URL=""
# Drains the alert outbox from inside the web process (no separate worker):
# set to any long random string. Leave empty to run `npm run alerts:worker` instead.
ALERT_WORKER_TOKEN=""
