DATABASE_URL="file:./dev.db"
# Local AI assistant (optional). Without Ollama the assistant uses keyword routing.
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1:8b"
OLLAMA_TIMEOUT_MS=90000
# Vision model for the Data Import "scan a handwritten note" feature (optional).
# Needs a multimodal model pulled separately, e.g.: ollama pull llava
OLLAMA_VISION_MODEL="llava"
# Vision inference is much slower than text — measured ~160s for one photo on
# llava even warm. Separate from OLLAMA_TIMEOUT_MS on purpose.
OLLAMA_VISION_TIMEOUT_MS=240000
